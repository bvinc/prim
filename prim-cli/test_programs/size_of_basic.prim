import std.io.println
import std.mem.size_of

struct Pair {
    a: i32,
    b: i32,
}

// size_of[T]() folds to a constant per type: scalars use their natural
// width; an aggregate reports its inline byte layout (the storage stride of
// an array/Vec element).
fn main() {
    println(size_of[u8]())     // 1
    println(size_of[u16]())    // 2
    println(size_of[u32]())    // 4
    println(size_of[u64]())    // 8
    println(size_of[bool]())   // 1
    println(size_of[Pair]())   // 8
}
