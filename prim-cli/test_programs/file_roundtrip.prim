import std.io.File
import std.io.Reader
import std.io.write_display
import std.io.println
import std.vec.new
import std.vec.push
import std.vec.get

// Write "hi" through the Writer-backed write_display; File closes on drop.
fn write_file() {
    let f = File.create("__prim_fs_test.txt")
    write_display(f, "hi", false)
}

// Read it back via the Reader trait into a Vec[u8] (grown to capacity with a
// few pushes), then print the byte count and the two bytes (104='h', 105='i').
fn read_file() {
    let g = File.open("__prim_fs_test.txt")
    let mut buf = new[u8]()
    push(edit buf, take 0u8)
    push(edit buf, take 0u8)
    push(edit buf, take 0u8)
    push(edit buf, take 0u8)
    let n = g.read(edit buf)
    println(n)
    println(get(buf, 0usize))
    println(get(buf, 1usize))
}

fn main() {
    write_file()
    read_file()
}
