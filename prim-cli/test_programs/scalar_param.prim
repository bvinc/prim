import std.io.println

// By-value scalar-ABI parameters (phase 3): a flat POD aggregate passed to a
// field-read-only free function crosses as one wasm value per field, no box.
struct Point { x: i32, y: i32 }
struct Vec3 { a: i32, b: i32, c: i32 }

fn dist_sq(p: Point) -> i32 { return p.x * p.x + p.y * p.y }
fn sum3(take v: Vec3) -> i32 { return v.a + v.b + v.c }

fn main() {
    let p = Point { x = 6, y = 8 }
    println(dist_sq(p))
    println(dist_sq(Point { x = 3, y = 4 }))
    let v = Vec3 { a = 1, b = 2, c = 3 }
    println(sum3(take v))
}
