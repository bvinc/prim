import std.io.println

// A view-kinded struct built from a *local* has no provenance the caller could
// pin, so returning it would dangle — an escape. (Building it from a borrowed
// parameter instead gives the caller something to derive from; see
// view_return_provenance.)
struct Point { x: i32 }

struct view Window { p: read Point }

fn make() -> Window {
    let pt = Point { x = 1 }
    let w = Window { p = read pt }
    return w
}

fn main() {
    println(1i32)
}
