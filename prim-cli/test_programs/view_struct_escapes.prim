import std.io.println

// A view-kinded struct may be used within its frame but not returned: its
// borrow is hidden behind the type name, so the caller can't be made to keep
// the source pinned (that derivation is a later stage). Returning it is an
// escape.
struct Point { x: i32 }

struct view Window { p: read Point }

fn make(pt: read Point) -> Window {
    return Window { p = read pt }
}

fn main() {
    println(1i32)
}
