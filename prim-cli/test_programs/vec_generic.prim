import std.io.println
import std.vec.new
import std.vec.push
import std.vec.get

struct Point { x: i32, y: i32 }

fn main() {
    // Vec[u64] — 8-byte elements (exercises size_of scaling)
    let nums = new[u64]()
    push(nums, 1000000000000u64)
    push(nums, 2000000000000u64)
    println(get(nums, 0usize))   // 1000000000000
    println(get(nums, 1usize))   // 2000000000000

    // Vec[Point] — struct (reference) elements
    let pts = new[Point]()
    push(pts, Point { x = 1, y = 2 })
    push(pts, Point { x = 3, y = 4 })
    let p = get(pts, 1usize)
    println(p.x)                 // 3
    println(p.y)                 // 4
}
