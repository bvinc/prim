import std.io.println
import std.time.Duration
import std.time.now

// Duration is plain arithmetic over nanoseconds; these are deterministic.
fn main() {
    println(Duration.from_secs(2u64).as_millis())      // 2000
    println(Duration.from_millis(5u64).as_nanos())     // 5000000
    // now() is monotonic: a later reading is never smaller.
    let a = now()
    let b = now()
    println(b >= a)                          // true
}
