import std.io.println

fn id(x: usize) -> usize {
    return x
}

// A `(` is a call only when glued to the name. Here the parenthesized line
// follows a complete statement, so it is its own grouped expression (the
// block's trailing value) rather than a call of `id(5)`. Before call-adjacency
// was enforced, `id(5usize)` ⏎ `(a + 1usize)` glued into `id(5usize)(a + 1usize)`
// and failed to parse.
fn f() -> usize {
    let a = id(5usize)
    return (a + 1usize)
}

fn main() {
    println(f()) // 6
}
