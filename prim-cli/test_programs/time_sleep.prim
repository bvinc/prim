import std.io.println
import std.rt.spawn
import std.time.sleep
import std.time.from_millis

// Two tasks sleep for different durations; the scheduler wakes each when its
// timer is due, so they finish in wake-time order regardless of spawn order.
fn fast() {
    sleep(from_millis(10u64))
    println(2i32)
}

fn slow() {
    sleep(from_millis(30u64))
    println(3i32)
}

fn main() {
    spawn(slow)
    spawn(fast)
    println(1i32)
}
