import std.io.println

// Hygiene (control case, currently correct): an inner loop whose bound legitimately
// references the *outer* loop variable must work -- the outer variable is in scope
// for the inner bound, and each inner loop counts up to the current outer value.
fn main() {
    let mut count = 0i32
    for a in 1i32..4i32 {
        for b in 0i32..a {
            count = count + 1
        }
    }
    println(count)   // 1 + 2 + 3 = 6
}
