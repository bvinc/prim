import std.io.println
import std.convert.i64_to_u64_wrapping

// All integer println functions are implemented in Prim now. Cover zero,
// negatives, the signed extremes, and unsigned values with the high bit
// set (which only print correctly with unsigned division).
fn main() {
    println(0i8)
    println(-42i8)
    println(255u8)
    println(-12345i16)
    println(54321u16)
    println(0i32)
    println(-2147483648)
    println(2147483647i32)
    println(4294967295u32)
    println(-9000000000000000000i64)
    println(9223372036854775807i64)
    println(12345u64)
    println(i64_to_u64_wrapping(0i64 - 1i64))
    println(-5isize)
    println(5usize)
}
