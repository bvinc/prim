import std.io.println_i32
import std.io.println_usize
import std.vec.new
import std.vec.push
import std.vec.get
import std.vec.set
import std.vec.len

fn main() {
    let v = new[i32]()
    let mut i = 0i32
    while i < 10 {
        push(v, i * i)            // forces regrowth 0 -> 4 -> 8 -> 16
        i = i + 1
    }
    println_usize(len(v))         // 10
    println_i32(get(v, 0usize))   // 0
    println_i32(get(v, 3usize))   // 9
    println_i32(get(v, 9usize))   // 81
    set(v, 3usize, 999)
    println_i32(get(v, 3usize))   // 999
}
