import std.io.File
import std.io.Reader
import std.io.println
import std.vec.new
import std.vec.push

// Opening a nonexistent file yields fd = -1; reading returns 0 and the owned
// File's drop-close is a harmless EBADF (no crash, no hang).
fn main() {
    let g = File.open("definitely_missing_file.txt")
    let mut buf = new[u8]()
    push(mut buf, own 0u8)
    let n = g.read_into(mut buf)
    println(n)
}
