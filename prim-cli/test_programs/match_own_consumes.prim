struct S { n: i32 }
enum Box { Full { s: S }, Empty }

// `match own e` with a genuinely moving arm is legal: the `own s` binding
// moves the payload, so the match consumes the scrutinee (documented by the
// `own` keyword). A later use of `b` is a moved-value error — consumption is
// real, not just decoration.
fn f(own b: Box) {
    match own b {
        Box.Full { own s } => println(s.n),
        Box.Empty => println(0i32),
    }
    match b {
        Box.Full { s } => println(s.n),
        Box.Empty => println(0i32),
    }
}

fn main() {
    let b = Box.Full { s = S { n = 5i32 } }
    f(own b)
}
