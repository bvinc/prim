import std.io.println
import std.vec.new
import std.vec.push
import std.vec.get

fn main() {
    let v = new[i32]()
    push(mut v, own 5)
    println(get(v, 0usize) |e| { e })   // 5
    println(get(v, 5usize) |e| { e })   // out of bounds -> panic, halts
    println(999i32)              // not reached
}
