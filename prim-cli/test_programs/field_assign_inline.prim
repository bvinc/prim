import std.io.println
import std.vec.new
import std.string.from_vec

// Assigning a whole moved value into an inline struct field (`h.s = ...`)
// copies the value's bytes into the field and frees the now-orphaned value
// box shell (not the buffer the field now owns). Printing the field afterwards
// proves the buffer stayed owned by `h`; over-freeing it would crash or
// corrupt the output.
struct Holder { s: String }

fn main() {
    let mut first = new[u8]()
    first.push(own 65u8)
    first.push(own 66u8)
    let mut h = Holder { s = from_vec(own first) }

    let mut second = new[u8]()
    second.push(own 70u8)
    second.push(own 71u8)
    second.push(own 72u8)

    h.s = from_vec(own second)
    println(h.s)   // FGH
}
