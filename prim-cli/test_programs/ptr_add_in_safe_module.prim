// Pointer arithmetic is a raw-core power. `std.ptr.add` is a trusted-only
// wrapper (it calls the raw `byte_add` intrinsic), so a safe module may not
// call it even though it is not itself `@runtime`.
import std.ptr.add

fn do_add(p: *mut u8) -> *mut u8 {
    return add[u8](p, 1usize)
}

fn main() {
}
