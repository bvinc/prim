import std.io.println
import std.vec.new
import std.vec.push
import std.vec.get

// 16 bytes exactly — the inline cutoff (MAX_INLINE_BYTES). A struct this size
// with no `Drop` is stored inline in the Vec slot, so the deref-read in `get`
// is a genuine byte copy: `get` is safe and must compile (pins the safe side
// of the boundary; a larger or `Drop`-implementing element is rejected — see
// vec_get_noncopy / vec_get_boxed_struct).
struct Inline16 { a: i32, b: i32, c: i32, d: i32 }

fn main() {
    let mut v = new[Inline16]()
    push(mut v, own Inline16 { a = 1, b = 2, c = 3, d = 4 })
    let x = get(v, 0usize)
    println(x.a + x.b + x.c + x.d)
}
