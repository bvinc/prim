import std.io.println
import std.vec.new
import std.vec.push
import std.vec.get

// `Vec.get` requires `T: Copy`: a non-`Copy` element can't be copied out of
// its slot (it would have to be moved and could double-free). `impl Copy` opts
// this struct in, so `get` is a genuine byte copy and must compile.
struct Inline16 { a: i32, b: i32, c: i32, d: i32 }

impl Copy for Inline16 {}

fn main() {
    let mut v = new[Inline16]()
    push(mut v, own Inline16 { a = 1, b = 2, c = 3, d = 4 })
    let x = get(v, 0usize) |e| { e }
    println(x.a + x.b + x.c + x.d)
}
