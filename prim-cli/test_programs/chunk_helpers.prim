mod chunk_helpers
import std.io.println
import std.mem.alloc
import std.mem.set_chunk_head
import std.mem.set_chunk_prev_foot
import std.mem.chunksize
import std.mem.cinuse
import std.mem.pinuse
import std.mem.chunk2mem
import std.mem.mem2chunk
import std.mem.next_chunk
import std.mem.prev_chunk
import std.mem.request2size
import std.ptr.addr

// Build two adjacent chunks by hand in a raw buffer and check that the chunk
// vocabulary reads the header back correctly. The first chunk is in-use, size
// 32, with the previous chunk marked in-use (PINUSE | CINUSE = 3).
unsafe fn main() {
    let buf = alloc(128usize)

    set_chunk_head(buf, 32usize | 3usize)
    println(chunksize(buf)) // flags masked off -> 32
    println(cinuse(buf)) // CINUSE set -> true
    println(pinuse(buf)) // PINUSE set -> true

    // payload sits one header (8 bytes) past the chunk start...
    println(addr[u8](chunk2mem(buf)) - addr[u8](buf)) // 8
    // ...and mem2chunk is its exact inverse.
    println(addr[u8](mem2chunk(chunk2mem(buf))) - addr[u8](buf)) // 0

    // next_chunk steps forward by chunksize.
    let second = next_chunk(buf)
    println(addr[u8](second) - addr[u8](buf)) // 32

    // Mark `second` free with prev_foot recording the gap, then walk back.
    set_chunk_prev_foot(second, 32usize)
    println(addr[u8](prev_chunk(second)) - addr[u8](buf)) // 0

    // request2size: below the minimum request snaps to MIN_CHUNK_SIZE (16),
    // otherwise it adds the one-word overhead and rounds up to 8.
    println(request2size(1usize)) // 16
    println(request2size(20usize)) // (20+4+7)&~7 = 24
    println(request2size(13usize)) // (13+4+7)&~7 = 24
}
