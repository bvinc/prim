import std.io.println

// A Drop type coerced into a `let` trait object: the trait object must own the
// box and run the concrete destructor exactly once when it goes out of scope.
struct R { id: i32 }

impl Drop for R {
    fn drop(mut self) { println(self.id) }
}

trait Id {
    fn id(self) -> i32;
}

impl Id for R {
    fn id(self) -> i32 { return self.id }
}

fn main() {
    let r = R { id = 7 }
    let g: Id = r          // moves r's box into the trait object
    println(g.id())        // 7
    // g drops here: R::drop(7) runs, then the box + fat pointer are freed.
}
