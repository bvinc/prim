import std.io.println

// A consuming match that takes one Drop field (`a`) and ignores another (`b`):
// the taken `x` drops at the arm's end (prints 1), and the un-taken Res(2)
// must ALSO drop (print 2) when the consumed scrutinee is cleaned up — not
// leak. Each runs exactly once (a double-free would print twice or crash).
struct Res { id: i32 }
impl Drop for Res { fn drop(mut self) { println(self.id) } }
struct Pair { a: Res, b: Res }

fn main() {
    let p = Pair { a = Res { id = 1 }, b = Res { id = 2 } }
    match p {
        Pair { a: own x, b: _ } => println(0i32),
    }
}
