// Negative test: two traits provide the same method name for one type, so a
// concrete `c.greet()` call is ambiguous and must be rejected (the declarations
// themselves are allowed — a bound would disambiguate a generic call).

struct Counter { n: i32 }

trait Greeter {
    fn greet(self) -> i32;
}

trait Other {
    fn greet(self) -> i32;
}

impl Greeter for Counter {
    fn greet(self) -> i32 { return self.n }
}

impl Other for Counter {
    fn greet(self) -> i32 { return self.n + 1i32 }
}

fn main() {
    let c = Counter { n = 1 }
    c.greet();
}
