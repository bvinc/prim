// Test modulo operator
import std.io.println

fn main() {
    // 17 % 5 = 2
    let a = 17i32 % 5
    println(a)

    // 10 % 3 = 1
    let b = 10i32 % 3
    println(b)

    // Test with larger numbers: 100 % 7 = 2
    let c = 100i32 % 7
    println(c)

    // Test precedence: 10 + 7 % 3 = 10 + 1 = 11
    let d = 10i32 + 7 % 3
    println(d)

    // Test negative left operand: -17 % 5 = -2
    let e = -17i32 % 5
    println(e)

    // Test negative right operand: 17 % -5 = 2
    let f = 17i32 % -5
    println(f)

    // Test both operands negative: -17 % -5 = -2
    let g = -17i32 % -5
    println(g)
}
