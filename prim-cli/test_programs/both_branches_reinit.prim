import std.io.println

struct S { n: i32 }

fn sink(take s: S) -> i32 { return s.n }

// A value moved before an if/else is live afterward when both branches
// reinitialize it.
fn main() {
    let mut a = S { n = 1 }
    let x = sink(take a)
    let cond = true
    if cond {
        a = S { n = 10 }
    } else {
        a = S { n = 20 }
    }
    println(a.n)
}
