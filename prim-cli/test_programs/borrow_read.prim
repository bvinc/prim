import std.io.println

// Borrow expressions: `read place` / `mut place` produce a tracked reference,
// representationally just the place's handle. Member access auto-derefs through
// the borrow.
struct Point { x: i32, y: i32 }

fn main() {
    let p = Point { x = 3i32, y = 4i32 }
    let r = read p
    println(r.x)        // 3
    println(r.y)        // 4
    let s = read p      // a shared read copies freely; two live views are fine
    println(s.x)        // 3
}
