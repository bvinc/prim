// Test type inference with comparison operations
import std.io.println

fn main() {
    // Comparison with inferred integer types
    let a = 10i32 > 5
    println(a)

    let b = 3i32 <= 3
    println(b)

    // Equality with inferred types
    let c = 42i32 == 42
    println(c)

    let d = 1i32 != 2
    println(d)

    // Comparison in if condition with inferred types
    let x = 100i32
    if x > 50 {
        println(1i32)
    } else {
        println(0i32)
    }
}
