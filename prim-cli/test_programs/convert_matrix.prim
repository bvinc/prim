import std.io.println

fn main() {
    println(i32.from_u8(200u8))                  // 200  (noop)
    println(u32.from_i32_wrapping(0i32 - 1i32))  // 4294967295 (noop reinterpret)
    println(u8.from_i32_wrapping(300i32))         // 44   (trunc u8)
    println(u16.from_i32_wrapping(70000i32))     // 4464 (trunc u16)
    println(i8.from_i32_wrapping(200i32))         // -56  (sext8)
    println(i16.from_i32_wrapping(40000i32))     // -25536 (sext16)
    println(i64.from_i32(0i32 - 5i32))           // -5   (ext i32 s)
    println(u64.from_u32(4000000000u32))         // 4000000000 (ext i32 u)
    println(i32.from_i64_wrapping(4294967303i64))// 7    (wrap i64)
    println(u8.from_i64_wrapping(300i64))         // 44   (wrap+trunc u8)
    println(u16.from_i64_wrapping(70000i64))     // 4464 (wrap+trunc u16)
    println(i8.from_i64_wrapping(200i64))         // -56  (wrap+sext8)
    println(i16.from_i64_wrapping(40000i64))     // -25536 (wrap+sext16)
    println(u16.from_u8(200u8))                  // 200  (lossless widen)
    println(i64.from_i8(0i8 - 1i8))              // -1   (lossless sext)
}
