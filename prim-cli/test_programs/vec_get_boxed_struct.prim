import std.vec.new
import std.vec.push
import std.vec.get

// 20 bytes — past the inline cutoff (MAX_INLINE_BYTES = 16), so the struct is
// stored as a box pointer in the Vec slot. `get`'s deref-read would copy that
// pointer: the returned value would alias the slot (double free on drop).
// Pins the unsafe side of the boundary — rejected at mono time.
struct Boxed20 { a: i32, b: i32, c: i32, d: i32, e: i32 }

fn main() {
    let mut v = new[Boxed20]()
    push(mut v, own Boxed20 { a = 1, b = 2, c = 3, d = 4, e = 5 })
    let x = get(v, 0usize)
    println(x.a)
}
