import std.vec.new
import std.vec.push
import std.vec.get

// 20 bytes, no `impl Copy` — stored as a box pointer in the Vec slot. `get`
// requires `T: Copy`, so `get[Boxed20]` is rejected as a bound error: the
// deref-read would otherwise copy the box pointer and alias the slot (double
// free on drop).
struct Boxed20 { a: i32, b: i32, c: i32, d: i32, e: i32 }

fn main() {
    let mut v = new[Boxed20]()
    push(mut v, own Boxed20 { a = 1, b = 2, c = 3, d = 4, e = 5 })
    let x = get(v, 0usize) |e| { e }
    println(x.a)
}
