import std.io.println

// A function may be written in statement form: its value comes from `return`
// on every path, with no trailing-expression value required.
fn five() -> i32 {
    return 5i32
}

fn pick(c: bool) -> i32 {
    if c {
        return 1i32
    } else {
        return 2i32
    }
}

fn main() {
    println(five())
    println(pick(true))
    println(pick(false))
}
