import std.io.println

struct Adder { base: i32 }

// `Adder` is used twice below (coerced into a trait object each time), so it
// must be `Copy`: a trait-object coercion in move position moves its source.
impl Copy for Adder { }

trait Computable {
    fn shift(self, by: i32) -> i32;
    fn combine(self, x: i32, y: i32) -> i32;
}

impl Computable for Adder {
    fn shift(self, by: i32) -> i32 {
        return self.base + by
    }
    fn combine(self, x: i32, y: i32) -> i32 {
        return self.base + x + y
    }
}

fn use_one(c: Computable, n: i32) -> i32 {
    return c.shift(n)
}

fn use_two(c: Computable, x: i32, y: i32) -> i32 {
    return c.combine(x, y)
}

fn main() {
    let a = Adder { base = 100 }
    println(use_one(a, 7))            // 107
    println(use_two(a, 10, 20))       // 130
}
