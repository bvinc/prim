struct Point { x: i32, y: i32 }

enum Shape {
    None,
    Some { p: Point },
}

// A `mut` arm binding is an exclusive borrow of the scrutinee — it writes back
// into the scrutinee's box. Under a bare/`read` `match` that would be an
// exclusive write through a read-only access, so it must be rejected: mutation
// requires the explicit `match mut`.
fn bump(read s: Shape) -> i32 {
    match s {
        Shape.Some { mut p } => { p.x = 99i32 },
        Shape.None => {},
    }
    return 0i32
}

fn main() {
    let s = Shape.Some { p = Point { x = 1i32, y = 2i32 } }
    bump(read s)
}
