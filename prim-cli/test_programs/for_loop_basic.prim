import std.io.println_i32

fn main() {
    // sum over a half-open range
    let mut sum = 0
    for i in 0..5 {
        sum = sum + i
    }
    println_i32(sum)        // 0+1+2+3+4 = 10

    // nested loops with a non-zero, variable upper bound
    let mut count = 0
    for a in 2..5 {
        for b in 0..a {
            count = count + 1
        }
    }
    println_i32(count)      // 2 + 3 + 4 = 9

    // empty range runs zero times
    for x in 5..5 {
        count = count + 100
    }
    println_i32(count)      // still 9
}
