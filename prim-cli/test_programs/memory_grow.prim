trusted mod memory_grow
import std.io.println
import std.wasm.memory.grow

fn main() {
    // memory.grow returns the previous page count and appends `pages` pages.
    // Capture all three results up front: println itself allocates (which can
    // grow memory), so we must measure before any printing. Deltas are checked
    // rather than absolute counts, which depend on the allocator's own growth.
    let a = grow(0usize) // current page count
    let b = grow(2usize) // == a, and grows by 2
    let c = grow(0usize) // == a + 2
    println(b - a) // 0
    println(c - a) // 2
}
