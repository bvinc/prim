import std.io.println

// Hygiene: the range bound is evaluated in the *enclosing* scope, so a bound
// that names the same identifier as the loop variable must see the outer
// binding, not the loop variable being introduced.
//
// KNOWN ISSUE: the for-desugar lowers the end expression inside the loop
// variable's scope, so `0..n` resolves to the loop variable and the loop
// becomes `while n < n` -> runs zero times, printing 0.
fn main() {
    let n = 3i32
    let mut count = 0i32
    for n in 0i32..n {
        count = count + 1
    }
    println(count)   // 3
}
