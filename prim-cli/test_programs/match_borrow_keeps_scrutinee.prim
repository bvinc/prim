import std.io.println

struct S { n: i32 }
enum Box { Full { s: S }, Empty }

// A bare `match` with only borrow arms does NOT consume: the scrutinee stays
// alive and can be matched again (the same arms run twice, printing 5 twice).
fn f(own b: Box) {
    match b {
        Box.Full { s } => println(s.n),
        Box.Empty => println(0i32),
    }
    match b {
        Box.Full { s } => println(s.n),
        Box.Empty => println(0i32),
    }
}

fn main() {
    let b = Box.Full { s = S { n = 5i32 } }
    f(own b)
}
