import std.io.println
import std.vec.new
import std.vec.push
import std.vec.get

struct S { n: i32 }

impl Drop for S {
    fn drop(mut self) { println(100i32 + self.n) }
}

// `Vec.get` requires `T: Copy`: `S` has a `Drop` impl, so it is not `Copy`
// (and is stored as a box pointer in the slot). `get[S]` is rejected as a
// bound error — the deref-read would otherwise copy the box pointer and alias
// the slot (double free / use-after-free).
fn main() {
    let mut v = new[S]()
    push(mut v, own S { n = 9 })
    let x = get(v, 0usize) |e| { e }
    println(x.n)
}
