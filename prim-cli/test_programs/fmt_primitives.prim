import std.io.print
import std.io.print_str

// Display is implemented for every primitive, so `print` renders them
// directly: unsigned and signed integers (including the negative path),
// floats (with trailing-zero trimming), and bool.
fn main() {
    print(255u8)
    print_str("")
    print(42u64)
    print_str("")
    print(0i64 - 7i64)
    print_str("")
    print(0i32 - 128i32)
    print_str("")
    print(3.5f64)
    print_str("")
    print(2.0f64)
    print_str("")
    print(true)
    print_str("")
    print(false)
    print_str("")
}
