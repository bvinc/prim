import std.io.println
import std.array.get

// Array[T, N] element access. `get` returns Option[T] — a copy of the element
// (copy-able types only), or None when out of bounds (no panic). Reading
// copies the element out; no raw `*mut`.
fn main() {
    let a: Array[i32, 4] = [10i32, 20i32, 30i32, 40i32]
    println(a.len())              // 4
    println(get(a, 0).unwrap())   // 10
    println(get(a, 3).unwrap())   // 40
    println(get(a, 9).is_none())  // true
}
