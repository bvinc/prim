import std.io.println

fn level4() -> i64 {
    println(4i64)
    return 42
}

fn level3() -> i64 {
    println(3i64)
    let result = level4()
    println(300i64 + result)
    return result
}

fn level2() -> i64 {
    println(2i64)
    let result = level3()
    println(200i64 + result)
    return result
}

fn level1() -> i64 {
    println(1i64)
    let result = level2()
    println(100i64 + result)
    return result
}

fn main() {
    println(0i64)
    let final_result = level1()
    println(final_result)
}
