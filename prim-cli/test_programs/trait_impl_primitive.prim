import std.io.println

// A trait implemented for a primitive type, then reached through a generic
// bound. The bound check, monomorphization, and static dispatch all resolve
// the primitive impl the same way they would a struct impl.
trait Label {
    fn label(self) -> i64;
}

impl Label for i32 {
    fn label(self) -> i64 { return 100i64 }
}

impl Label for bool {
    fn label(self) -> i64 { return 1i64 }
}

fn labeled[T: Label](x: T) -> i64 {
    return x.label()
}

fn main() {
    println(labeled[i32](7i32))
    println(labeled[bool](true))
}
