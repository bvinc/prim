import std.io.println

// Prints its tag when evaluated, so the absence of a tag proves the
// right operand was short-circuited away.
fn noisy(tag: i32, val: bool) -> bool {
    println(tag)
    val
}

fn main() {
    // && stops at the first false: 99 is never printed.
    if noisy(1, false) && noisy(99, true) { println(10i32) } else { println(20i32) }
    // || stops at the first true: 98 is never printed.
    if noisy(2, true) || noisy(98, false) { println(30i32) } else { println(40i32) }
    // logical not and grouping
    let t = true
    let f = false
    if !f && !(t && f) { println(50i32) } else { println(60i32) }
}
