import std.io.println
import std.io.print
import std.fmt.Display
import std.fmt.Formatter

// A user type renders itself by writing into the shared Formatter; nested
// writes (the int fields) land in the same buffer.
struct Pair { a: u64, b: u64 }

impl Display for Pair {
    fn fmt(view self, edit f: Formatter) {
        f.write_str("(")
        f.write_u64(self.a)
        f.write_str(", ")
        f.write_u64(self.b)
        f.write_str(")")
    }
}

fn main() {
    let p = Pair { a = 3u64, b = 7u64 }
    print(p)
    println("")
}
