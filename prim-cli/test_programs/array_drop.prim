import std.io.println

// A fixed array Array[T, N] is a homogeneous value aggregate. Constructing one
// builds all N elements; dropping it recurses into each element's drop (which
// previously leaked). Expect 0, then each element's id as it drops.
struct Res { id: i32 }
impl Drop for Res { fn drop(edit self) { println(self.id) } }

fn main() {
    let a: Array[Res, 3] = [Res { id = 1 }, Res { id = 2 }, Res { id = 3 }]
    println(0i32)
}
