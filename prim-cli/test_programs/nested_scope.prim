import std.io.println

struct S { n: i32 }

fn sink(own s: S) -> i32 { return s.n }

// A move inside a nested scope doesn't affect an outer-scope binding.
fn main() {
    let a = S { n = 42 }
    let mut k = 0i32
    if true {
        let b = S { n = 7 }
        k = sink(own b)
    }
    println(a.n)
}
