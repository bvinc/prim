import std.io.println

// A primitive type can carry both methods (self) and associated functions
// (no self), called the same way as on a struct or enum.
impl u8 {
    fn doubled(self) -> u8 {
        self + self
    }
    fn from_i32(n: i32) -> u8 {
        u8.from_i32_wrapping(n)
    }
}

fn main() {
    let x = 5u8
    println(x.doubled())        // 10 (method called on a primitive value)
    println(u8.from_i32(300))   // 44 (associated function on a primitive)
}
