// Binding a non-Copy payload in a match requires `own` (extracting owned data
// from a scrutinee is explicit). Without it, this is an error.
struct S { n: i32 }
enum Box {
    Empty,
    Full { s: S },
}

fn main() {
    let b = Box.Full { s = S { n = 1 } }
    let r = match b {
        Box.Full { s } => 0i32,
        Box.Empty => 0i32,
    }
}
