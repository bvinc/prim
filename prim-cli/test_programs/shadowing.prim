// Comprehensive test of variable shadowing
// Shadowing rules should match Rust:
// - Shadowing within a block does not permanently shadow outer variables
// - Shadowing can change mutability
// - Each shadow creates a new variable

import std.io.println

fn test_basic_shadow() -> i32 {
    let x = 1i32
    let x = 2i32
    return x
}

fn test_block_shadow() -> i32 {
    let x = 10i32
    {
        let x = 20i32
        // x is 20 here, but doesn't affect outer x
    }
    return x  // should be 10
}

fn test_nested_blocks() -> i32 {
    let x = 100i32
    {
        let x = 200i32
        {
            let x = 300i32
            // x is 300 here
        }
        // x is 200 here
    }
    return x  // should be 100
}

fn test_shadow_in_if() -> i32 {
    let x = 1i32
    if true {
        let x = 2i32
        // x is 2 here
    }
    return x  // should be 1
}

fn test_shadow_in_if_else() -> i32 {
    let x = 1i32
    if false {
        let x = 2i32
    } else {
        let x = 3i32
    }
    return x  // should be 1
}

fn test_mutability_change() -> i32 {
    let x = 5i32
    let mut x = x + 1  // shadow with mutable version
    x = x + 1
    return x  // should be 7
}

fn test_shadow_uses_outer() -> i32 {
    let x = 10i32
    let x = x + 5  // new x based on old x
    return x  // should be 15
}

fn test_block_shadow_uses_outer() -> i32 {
    let x = 100i32
    {
        let x = x + 50  // inner x based on outer x
        // x is 150 here
    }
    return x  // should still be 100
}

fn main() {
    println(test_basic_shadow())       // 2
    println(test_block_shadow())       // 10
    println(test_nested_blocks())      // 100
    println(test_shadow_in_if())       // 1
    println(test_shadow_in_if_else())  // 1
    println(test_mutability_change())  // 7
    println(test_shadow_uses_outer())  // 15
    println(test_block_shadow_uses_outer())  // 100
}
