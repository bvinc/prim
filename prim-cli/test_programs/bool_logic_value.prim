import std.io.println_bool

// && / || / ! used as values (not just in if-conditions).
fn main() {
    let a = true
    let b = false
    println_bool(a && b)     // false
    println_bool(a || b)     // true
    println_bool(!a)         // false
    println_bool(!b)         // true
    println_bool(a && !b)    // true
    println_bool(!a || b)    // false
    println_bool(!(a && b))  // true
}
