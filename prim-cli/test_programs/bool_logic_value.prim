import std.io.println

// && / || / ! used as values (not just in if-conditions).
fn main() {
    let a = true
    let b = false
    println(a && b)     // false
    println(a || b)     // true
    println(!a)         // false
    println(!b)         // true
    println(a && !b)    // true
    println(!a || b)    // false
    println(!(a && b))  // true
}
