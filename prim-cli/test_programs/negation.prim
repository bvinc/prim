import std.io.println

// The unary `-` operator: on variables, floats, sub-expressions, the most
// negative literal of a type (i8::MIN, i32::MIN), and double negation.
fn main() {
    let a = 5i32
    println(-a)
    let f = 2.5f64
    println(-f)
    println(-(3i32 + 4i32))
    let lo: i8 = -128
    println(lo)
    let imin: i32 = -2147483648
    println(imin)
    let neg = -7i64
    println(-neg)
}
