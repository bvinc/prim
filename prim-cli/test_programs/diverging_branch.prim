import std.io.println

struct S { n: i32 }

fn sink(s: own S) -> i32 { return s.n }

// A branch that always returns doesn't contribute its move to the join, so
// the value is still live on the path that continues.
fn pick(a: own S, cond: bool) -> i32 {
    if cond {
        return sink(own a)
    }
    return a.n
}

fn main() {
    let a = S { n = 42 }
    println(pick(own a, false))
}
