import std.io.println

struct R { id: i32 }
impl Drop for R {
    fn drop(mut self) { println(self.id) }
}

// A resource moved (`own`) into a callee is dropped by the callee, not the
// caller — exactly once.
fn consume(own r: R) {
    println(9i32)
}

fn main() {
    let a = R { id = 1 }
    consume(own a)
    println(0i32)
}
