import std.io.println

struct R { id: i32 }
impl Drop for R {
    fn drop(mut self) { println(self.id) }
}

// A chain of moves: only the final owner `c` is live at scope exit, so the
// value drops exactly once despite three bindings naming it.
fn main() {
    let a = R { id = 7 }
    let own b = a
    let own c = b
    println(0i32)
}
