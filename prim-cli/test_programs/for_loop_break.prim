import std.io.println

fn main() {
    // break out of a for loop (break inside an if inside the loop)
    let mut found = 0i32 - 1
    for i in 0i32..100i32 {
        if i == 7 {
            found = i
            break
        }
    }
    println(found)   // 7

    // break before exhausting a huge range
    let mut s = 0i32
    for i in 0i32..1000000i32 {
        if i >= 5 { break }
        s = s + i
    }
    println(s)       // 0+1+2+3+4 = 10
}
