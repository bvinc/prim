import std.io.println_i32

fn main() {
    // break out of a for loop (break inside an if inside the loop)
    let mut found = 0 - 1
    for i in 0..100 {
        if i == 7 {
            found = i
            break
        }
    }
    println_i32(found)   // 7

    // break before exhausting a huge range
    let mut s = 0
    for i in 0..1000000 {
        if i >= 5 { break }
        s = s + i
    }
    println_i32(s)       // 0+1+2+3+4 = 10
}
