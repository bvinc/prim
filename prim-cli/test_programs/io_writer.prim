import std.io.stdout
import std.vec.Vec
import std.vec.new

// The byte-stream Writer: build a Vec[u8] and write it to stdout via the
// File handle. (Writer.write returns the byte count; discarded with `;`.)
fn main() {
    let v = new[u8]()
    v.push(own 72u8)
    v.push(own 105u8)
    v.push(own 10u8)
    stdout().write(v);
}
