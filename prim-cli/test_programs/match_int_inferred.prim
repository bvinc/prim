import std.io.println

// Literal patterns own their type from the scrutinee (no suffix needed).
fn classify(n: i32) -> i32 {
    return match n {
        0 => 10i32,
        1 => 20i32,
        _ => 30i32,
    }
}

fn main() {
    println(classify(0i32))
    println(classify(1i32))
    println(classify(9i32))
}
