struct S { n: i32 }
enum Box {
    Empty,
    Full { s: S },
}

fn sink(own s: S) -> i32 { return s.n }

// A `read`/bare arm binding is a second-class borrow: unmovable, exactly like a
// borrow parameter. Moving the payload out of it escapes the borrow.
fn main() {
    let b = Box.Full { s = S { n = 1 } }
    let r = match b {
        Box.Full { s } => sink(own s),
        Box.Empty => 0i32,
    }
}
