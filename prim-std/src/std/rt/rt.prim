mod rt

import std.sys.now_nanos
import std.sys.poll
import std.mem.alloc
import std.mem.free
import std.ptr.at
import std.vec.Vec
import std.vec.new
import std.vec.len
import std.vec.get
import std.vec.set
import std.vec.push

// Cooperatively yield from the current green thread, returning control to
// the scheduler. The scheduler picks the next runnable task (or, in the
// single-task case, this same one) and resumes it. Lowers to wasm
// `suspend $yield_tag`; the scheduler's resume handler installs the
// matching `on $yield` clause.
@runtime("prim_rt_yield")
fn yield();

// Resume the task at `handle` (a slot in the runtime task table). Runs it
// until it yields or finishes. Returns true if it yielded (still runnable),
// false if it finished (its slot is now empty). Lowers to a call into the
// runtime's resume helper, which installs the `on $yield` handler and stores
// the resumed continuation back into the slot.
@runtime("prim_rt_resume")
fn resume(handle: usize) -> bool;

// Number of slots in the task table, counting both live and finished tasks.
@runtime("prim_rt_task_count")
fn task_count() -> usize;

// True if the task at `handle` still has a continuation (has not finished).
@runtime("prim_rt_task_live")
fn task_live(handle: usize) -> bool;

// Create a task from a `fn() -> ()` and return its handle (a new slot in the
// task table). The argument is a function name; the scheduler will run the
// task on its next pass. Lowers to `ref.func f; cont.new; table.grow`.
@runtime("prim_rt_spawn")
fn spawn() -> usize;

// Seed the program's `main` as a task and return its handle. Equivalent to
// `spawn(main)`, but resolves `main` in the compiler so the entry point can
// seed it without naming a function from another module.
@runtime("prim_rt_spawn_main")
fn spawn_main() -> usize;

// The program's entry point (exported as wasm `_start`). Seeds `main` as the
// first task, then runs the scheduler until every task has finished.
@entry
fn boot() {
    spawn_main()
    schedule()
}

// The scheduler loop, entered from `_start` after `main` is seeded as task 0.
// Park state: a one-slot channel from a parking task to the scheduler. The
// scheduler clears KIND before each resume; a task that wants to wait sets it
// (via the park_* helpers) just before yielding, and the scheduler reads it
// back. A plain yield() leaves KIND = 0, "runnable now".
//   0 = runnable   1 = timer (DEADLINE)   2 = fd readable   3 = fd writable
let mut PENDING_KIND: i32 = 0i32;
let mut PENDING_DEADLINE: u64 = 0u64;
let mut PENDING_FD: i32 = 0i32;

// Suspend until at least `deadline` (monotonic nanoseconds). Backs time.sleep.
fn park_until(deadline: u64) {
    PENDING_KIND = 1i32
    PENDING_DEADLINE = deadline
    yield()
}

// Suspend until `fd` is readable. Backs reads in std.io.
fn park_on_read(fd: i32) {
    // An invalid fd (e.g. -1 from a failed open) is never readable; don't park
    // on it forever — let the following read hit EBADF and return 0.
    if fd < 0i32 {
        return
    }
    PENDING_KIND = 2i32
    PENDING_FD = fd
    yield()
}

// Suspend until `fd` is writable. Backs writes in std.io.
fn park_on_write(fd: i32) {
    if fd < 0i32 {
        return
    }
    PENDING_KIND = 3i32
    PENDING_FD = fd
    yield()
}

// Build one WASI poll_oneoff subscription per parked task, block until at least
// one fires, then mark those tasks runnable. Each subscription carries the task
// handle as `userdata`, so a fired event names the task to wake. Subscription
// layout (48 bytes): userdata@0, eventtype@8, then the variant — clock is
// id@16/timeout@24/precision@32/flags@40; fd read/write is fd@16. Called only
// when no task is currently runnable.
fn poll_parked(kind: edit Vec[i32], deadline: view Vec[u64], fd: view Vec[i32]) {
    let n = task_count()
    let mut nsubs = 0usize
    let mut i = 0usize
    while i < n {
        if task_live(i) {
            if get[i32](kind, i) != 0i32 {
                nsubs = nsubs + 1usize
            }
        }
        i = i + 1usize
    }
    if nsubs == 0usize {
        return
    }

    let subs = alloc(nsubs * 48usize)
    let events = alloc(nsubs * 32usize)
    let mut s = 0usize
    i = 0usize
    while i < n {
        if task_live(i) {
            let k = get[i32](kind, i)
            if k != 0i32 {
                let off = s * 48usize
                *at[u64](subs, off) = u64.from_usize(i)
                if k == 1i32 {
                    *at[u8](subs, off + 8usize) = 0u8
                    *at[u32](subs, off + 16usize) = 1u32
                    *at[u64](subs, off + 24usize) = get[u64](deadline, i)
                    *at[u64](subs, off + 32usize) = 0u64
                    *at[u16](subs, off + 40usize) = 1u16
                } else {
                    *at[u8](subs, off + 8usize) = u8.from_i32_wrapping(k - 1i32)
                    *at[u32](subs, off + 16usize) = u32.from_i32_wrapping(get[i32](fd, i))
                }
                s = s + 1usize
            }
        }
        i = i + 1usize
    }

    let nready = poll(subs, events, nsubs)
    let mut e = 0usize
    while e < nready {
        let h = usize.from_u64_wrapping(*at[u64](events, e * 32usize))
        set[i32](edit kind, h, take 0i32)
        e = e + 1usize
    }
    free(subs)
    free(events)
}

// The scheduler loop, entered from `_start` after `main` is seeded as task 0.
// Resumes every runnable task in a pass; a task that parks records why and is
// skipped until its waker fires. When no task is runnable, `poll_parked` blocks
// on all wakers at once (timers + fd readiness/writability). `task_count()` is
// re-read each step so a task spawned mid-pass is picked up immediately. Exits
// once no task remains.
fn schedule() {
    let mut kind = new[i32]()
    let mut deadline = new[u64]()
    let mut fd = new[i32]()
    loop {
        let mut any_live = false
        let mut ran = false
        let mut i = 0usize
        while i < task_count() {
            while len[i32](kind) <= i {
                push[i32](edit kind, take 0i32)
                push[u64](edit deadline, take 0u64)
                push[i32](edit fd, take 0i32)
            }
            if task_live(i) {
                any_live = true
                if get[i32](kind, i) == 0i32 {
                    PENDING_KIND = 0i32
                    if resume(i) {
                        set[i32](edit kind, i, take PENDING_KIND)
                        set[u64](edit deadline, i, take PENDING_DEADLINE)
                        set[i32](edit fd, i, take PENDING_FD)
                    }
                    ran = true
                }
            }
            i = i + 1usize
        }
        if !any_live {
            break
        }
        if !ran {
            poll_parked(edit kind, deadline, fd)
        }
    }
}
