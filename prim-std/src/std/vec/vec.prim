mod vec

import std.mem.realloc
import std.mem.dealloc
import std.ptr.null
import std.ptr.add
import std.ptr.drop_in_place
import std.sys.panic

// A growable array. `ptr` points at `cap` slots of T; the first `len` are
// live. Passed by handle (structs are reference types), so the mutating
// functions update the caller's vector in place.
struct Vec[T] {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

// Drop each live element, then free the backing buffer. Elements live in the
// buffer behind `ptr` (not as struct fields), so they're dropped explicitly
// with `drop_in_place` — a no-op for elements with no destructor. A null `ptr`
// (empty Vec) is fine; the loop runs zero times and `dealloc` ignores null.
impl Drop for Vec {
    fn drop(mut self) {
        let mut i = 0usize
        while i < self.len {
            drop_in_place[T](add[T](self.ptr, i))
            i = i + 1usize
        }
        dealloc[T](self.ptr)
    }
}

fn new[T]() -> Vec[T] {
    return Vec { ptr = null[T](), len = 0usize, cap = 0usize }
}

fn len[T](v: read Vec[T]) -> usize {
    return v.len
}

fn push[T](v: mut Vec[T], value: T) {
    if v.len == v.cap {
        let mut new_cap = 4usize
        if v.cap != 0usize {
            new_cap = v.cap * 2usize
        }
        v.ptr = realloc[T](v.ptr, v.len, new_cap)
        v.cap = new_cap
    }
    *add[T](v.ptr, v.len) = value
    v.len = v.len + 1
}

fn get[T](v: read Vec[T], i: usize) -> T {
    if i >= v.len {
        panic("Vec.get: index out of bounds")
    }
    return *add[T](v.ptr, i)
}

// Borrow element i in place: `at` for a shared read, `at_mut` for exclusive
// mutation. The returned borrow is tracked against the vector, so the vector
// cannot be mutated (e.g. pushed) while the borrow is live.
fn at[T](v: read Vec[T], i: usize) -> read T {
    if i >= v.len {
        panic("Vec.at: index out of bounds")
    }
    return read *add[T](v.ptr, i)
}

fn at_mut[T](v: mut Vec[T], i: usize) -> mut T {
    if i >= v.len {
        panic("Vec.at_mut: index out of bounds")
    }
    return mut *add[T](v.ptr, i)
}

fn set[T](v: mut Vec[T], i: usize, value: T) {
    if i >= v.len {
        panic("Vec.set: index out of bounds")
    }
    *add[T](v.ptr, i) = value
}
