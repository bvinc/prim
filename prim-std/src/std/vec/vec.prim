mod vec

import std.mem.realloc
import std.mem.dealloc
import std.ptr.null
import std.ptr.add
import std.ptr.drop_in_place
import std.sys.panic

// A growable array. `ptr` points at `cap` slots of T; the first `len` are
// live. Passed by handle (structs are reference types), so the mutating
// functions update the caller's vector in place.
struct Vec[T] {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

// Drop each live element, then free the backing buffer. Elements live in the
// buffer behind `ptr` (not as struct fields), so they're dropped explicitly
// with `drop_in_place` — a no-op for elements with no destructor. A null `ptr`
// (empty Vec) is fine; the loop runs zero times and `dealloc` ignores null.
impl Drop for Vec {
    fn drop(mut self) {
        let mut i = 0usize
        while i < self.len {
            drop_in_place[T](add[T](self.ptr, i))
            i = i + 1usize
        }
        dealloc[T](self.ptr)
    }
}

fn new[T]() -> Vec[T] {
    return Vec { ptr = null[T](), len = 0usize, cap = 0usize }
}

fn len[T](read v: Vec[T]) -> usize {
    return v.len
}

fn push[T](mut v: Vec[T], own value: T) {
    if v.len == v.cap {
        let mut new_cap = 4usize
        if v.cap != 0usize {
            new_cap = v.cap * 2usize
        }
        v.ptr = realloc[T](v.ptr, v.len, new_cap)
        v.cap = new_cap
    }
    *add[T](v.ptr, v.len) = value
    v.len = v.len + 1
}

// Read element `i` as a copy. Enforced: the element must be copy-able — a
// scalar, pointer, or inline (small, no-`Drop`) aggregate — because `*p` is a
// deref-read of the slot; a boxed element would copy the box pointer and
// alias the slot (double free on drop), which the compiler rejects at
// monomorphization. Index loops are the v1 replacement for reference-yielding
// iterators.
fn get[T](read v: Vec[T], i: usize) -> T {
    if i >= v.len {
        panic("Vec.get: index out of bounds")
    }
    return *add[T](v.ptr, i)
}

fn set[T](mut v: Vec[T], i: usize, own value: T) {
    if i >= v.len {
        panic("Vec.set: index out of bounds")
    }
    *add[T](v.ptr, i) = value
}
