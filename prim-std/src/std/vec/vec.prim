mod vec

import std.mem.realloc
import std.mem.dealloc
import std.mem.size_of
import std.mem.alloc_array
import std.mem.copy_bytes
import std.ptr.null
import std.ptr.add
import std.ptr.drop_in_place
import std.sys.panic

// A growable array. `ptr` points at `cap` slots of T (each an inline value);
// the first `len` are live. `Vec` is passed as a `mut`/`read` borrow by the
// mutating functions, so they update the caller's vector in place.
struct Vec[T] {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

// Drop each live element, then free the backing buffer. Elements live in the
// buffer behind `ptr` (not as struct fields), so they're dropped explicitly
// with `drop_in_place` — a no-op for elements with no destructor. A null `ptr`
// (empty Vec) is fine; the loop runs zero times and `dealloc` ignores null.
impl Drop for Vec {
    fn drop(mut self) {
        let mut i = 0usize
        while i < self.len {
            unsafe {
                drop_in_place[T](add[T](self.ptr, i))
            }
            i = i + 1usize
        }
        unsafe {
            dealloc[T](self.ptr)
        }
    }
}

fn new[T]() -> Vec[T] {
    unsafe {
        return Vec { ptr = null[T](), len = 0usize, cap = 0usize }
    }
}

fn len[T](read v: Vec[T]) -> usize {
    return v.len
}

fn push[T](mut v: Vec[T], own value: T) {
    if v.len == v.cap {
        let mut new_cap = 4usize
        if v.cap != 0usize {
            new_cap = v.cap * 2usize
            if new_cap < v.cap {
                // The capacity doubled past 2^31 and wrapped to a small
                // number; realloc would shrink the buffer and the copy that
                // follows would overrun it. A Vec at 2^31 elements is at the
                // 32-bit heap's practical limit — abort rather than corrupt.
                panic("Vec.push: capacity overflow")
            }
        }
        unsafe {
            v.ptr = realloc[T](v.ptr, v.len, new_cap)
        }
        v.cap = new_cap
    }
    unsafe {
        *add[T](v.ptr, v.len) = value
    }
    v.len = v.len + 1
}

// Read element `i` as a copy. The element must be `Copy` (a scalar/pointer, or
// an `impl Copy` struct): `*p` is a deref-read of the slot, and a non-`Copy`
// element is stored as a box pointer, so copying it out would alias the slot
// and double-free on drop. `T: Copy` makes that a plain type error at the call
// site. Index loops are the v1 replacement for reference-yielding iterators.
fn get[T: Copy](read v: Vec[T], i: usize) -> T {
    if i >= v.len {
        panic("Vec.get: index out of bounds")
    }
    unsafe {
        return *add[T](v.ptr, i)
    }
}

fn set[T](mut v: Vec[T], i: usize, own value: T) {
    if i >= v.len {
        panic("Vec.set: index out of bounds")
    }
    // Drop the displaced element before overwriting its slot, so replacing a
    // needs-drop element (e.g. Vec[String]) doesn't leak its box. A no-op for
    // scalar/inline elements with no destructor.
    unsafe {
        drop_in_place[T](add[T](v.ptr, i))
        *add[T](v.ptr, i) = value
    }
}

// Hand element `i` to a block as a *read-only* binding, for every element
// type (no `T: Copy`). The block borrows the slot in place, so it never moves
// or copies the element out of the Vec; `return`/`break` inside the block bind
// to the caller. Bounds-checked like `get`.
inline fn with[T](read v: Vec[T], i: usize, b: block(T)) {
    if i >= v.len {
        panic("Vec.with: index out of bounds")
    }
    unsafe {
        b(*add[T](v.ptr, i))
    }
}

// Like `with`, but the block receives the element as a `mut` binding: writes
// (`e = v`, `e.field = v`, passing `e` onward as `mut`) write through to the
// slot in place. A whole-assign `e = v` first drops the displaced element
// (like `set`), so replacing a `Drop` element does not leak it.
inline fn with_mut[T](mut v: Vec[T], i: usize, b: block(mut T)) {
    if i >= v.len {
        panic("Vec.with_mut: index out of bounds")
    }
    unsafe {
        b(mut *add[T](v.ptr, i))
    }
}

// Swap elements `i` and `j` in place, for *every* element type — including
// `Drop`-implementing ones. Elements are inline values, so exchanging the two
// slots' `size_of[T]` raw bytes through a one-slot scratch buffer *is* the
// value swap: no `T` value is ever formed, no destructor runs, and each value
// still ends up owned by exactly one slot (just the other one).
fn swap[T](mut v: Vec[T], i: usize, j: usize) {
    if i >= v.len || j >= v.len {
        panic("Vec.swap: index out of bounds")
    }
    if i == j {
        return
    }
    unsafe {
        let pi = add[T](v.ptr, i)
        let pj = add[T](v.ptr, j)
        let n = size_of[T]()
        let scratch = alloc_array[T](1)
        copy_bytes[T](scratch, pi, n)
        copy_bytes[T](pi, pj, n)
        copy_bytes[T](pj, scratch, n)
        dealloc[T](scratch)
    }
}
