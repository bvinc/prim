mod vec

import std.mem.realloc
import std.mem.dealloc
import std.ptr.null
import std.ptr.add
import std.sys.panic

// A growable array. `ptr` points at `cap` slots of T; the first `len` are
// live. Passed by handle (structs are reference types), so the mutating
// functions update the caller's vector in place.
struct Vec[T] {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

// Free the backing buffer at scope end. This reclaims the array allocation,
// which is complete for elements with no destructor (the common case). NOTE:
// it does not yet run destructors on the live elements, so a `Vec` of a type
// that owns a resource (e.g. `String`) still leaks each element — that needs a
// drop-in-place primitive. A null `ptr` (empty Vec) is fine; `dealloc` ignores it.
impl Drop for Vec {
    fn drop(edit self) {
        dealloc[T](self.ptr)
    }
}

fn new[T]() -> Vec[T] {
    return Vec { ptr = null[T](), len = 0usize, cap = 0usize }
}

fn len[T](view v: Vec[T]) -> usize {
    return v.len
}

fn push[T](edit v: Vec[T], take value: T) {
    if v.len == v.cap {
        let mut new_cap = 4usize
        if v.cap != 0usize {
            new_cap = v.cap * 2usize
        }
        v.ptr = realloc[T](v.ptr, v.len, new_cap)
        v.cap = new_cap
    }
    *add[T](v.ptr, v.len) = value
    v.len = v.len + 1
}

fn get[T](view v: Vec[T], i: usize) -> T {
    if i >= v.len {
        panic("Vec.get: index out of bounds")
    }
    return *add[T](v.ptr, i)
}

fn set[T](edit v: Vec[T], i: usize, take value: T) {
    if i >= v.len {
        panic("Vec.set: index out of bounds")
    }
    *add[T](v.ptr, i) = value
}
