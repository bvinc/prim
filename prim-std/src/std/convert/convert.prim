impl isize {
    @runtime("prim_rt_conv_noop")
    fn from_i8(x: i8) -> isize;
    @runtime("prim_rt_conv_noop")
    fn from_u8(x: u8) -> isize;
    @runtime("prim_rt_conv_noop")
    fn from_i16(x: i16) -> isize;
    @runtime("prim_rt_conv_noop")
    fn from_u16(x: u16) -> isize;
    @runtime("prim_rt_conv_noop")
    fn from_i32(x: i32) -> isize;
    @runtime("prim_rt_conv_noop")
    fn from_u32_wrapping(x: u32) -> isize;
    @runtime("prim_rt_conv_noop")
    fn from_usize_wrapping(x: usize) -> isize;
