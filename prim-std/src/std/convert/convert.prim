mod convert

// Primitive conversions, exposed as associated functions on the target
// type: `u64.from_u32(x)`, `u8.from_i64_wrapping(x)`, `u64.from_f64_trunc(x)`.
// Lossless conversions are named `from_<src>`; conversions that can lose
// information keep a `_wrapping` (keeps the low bits) or `_trunc` (truncates
// a float toward zero, saturating) suffix as the signal. Each is a thin
// `@runtime` intrinsic; the module is force-loaded by the prelude so the
// functions resolve everywhere without an import.

impl u8 {
    @runtime("prim_rt_conv_trunc_u8")
    fn from_i8_wrapping(x: i8) -> u8;
    @runtime("prim_rt_conv_trunc_u8")
    fn from_i16_wrapping(x: i16) -> u8;
    @runtime("prim_rt_conv_trunc_u8")
    fn from_u16_wrapping(x: u16) -> u8;
    @runtime("prim_rt_conv_trunc_u8")
    fn from_i32_wrapping(x: i32) -> u8;
    @runtime("prim_rt_conv_trunc_u8")
    fn from_u32_wrapping(x: u32) -> u8;
    @runtime("prim_rt_conv_trunc_u8")
    fn from_isize_wrapping(x: isize) -> u8;
    @runtime("prim_rt_conv_trunc_u8")
    fn from_usize_wrapping(x: usize) -> u8;
    @runtime("prim_rt_conv_wrap_trunc_u8")
    fn from_i64_wrapping(x: i64) -> u8;
    @runtime("prim_rt_conv_wrap_trunc_u8")
    fn from_u64_wrapping(x: u64) -> u8;
}

impl i8 {
    @runtime("prim_rt_conv_sext8")
    fn from_u8_wrapping(x: u8) -> i8;
    @runtime("prim_rt_conv_sext8")
    fn from_i16_wrapping(x: i16) -> i8;
    @runtime("prim_rt_conv_sext8")
    fn from_u16_wrapping(x: u16) -> i8;
    @runtime("prim_rt_conv_sext8")
    fn from_i32_wrapping(x: i32) -> i8;
    @runtime("prim_rt_conv_sext8")
    fn from_u32_wrapping(x: u32) -> i8;
    @runtime("prim_rt_conv_sext8")
    fn from_isize_wrapping(x: isize) -> i8;
    @runtime("prim_rt_conv_sext8")
    fn from_usize_wrapping(x: usize) -> i8;
    @runtime("prim_rt_conv_wrap_sext8")
    fn from_i64_wrapping(x: i64) -> i8;
    @runtime("prim_rt_conv_wrap_sext8")
    fn from_u64_wrapping(x: u64) -> i8;
}

impl u16 {
    @runtime("prim_rt_conv_trunc_u16")
    fn from_i8_wrapping(x: i8) -> u16;
    @runtime("prim_rt_conv_noop")
    fn from_u8(x: u8) -> u16;
    @runtime("prim_rt_conv_trunc_u16")
    fn from_i16_wrapping(x: i16) -> u16;
    @runtime("prim_rt_conv_trunc_u16")
    fn from_i32_wrapping(x: i32) -> u16;
    @runtime("prim_rt_conv_trunc_u16")
    fn from_u32_wrapping(x: u32) -> u16;
    @runtime("prim_rt_conv_trunc_u16")
    fn from_isize_wrapping(x: isize) -> u16;
    @runtime("prim_rt_conv_trunc_u16")
    fn from_usize_wrapping(x: usize) -> u16;
    @runtime("prim_rt_conv_wrap_trunc_u16")
    fn from_i64_wrapping(x: i64) -> u16;
    @runtime("prim_rt_conv_wrap_trunc_u16")
    fn from_u64_wrapping(x: u64) -> u16;
}

impl i16 {
    @runtime("prim_rt_conv_noop")
    fn from_i8(x: i8) -> i16;
    @runtime("prim_rt_conv_noop")
    fn from_u8(x: u8) -> i16;
    @runtime("prim_rt_conv_sext16")
    fn from_u16_wrapping(x: u16) -> i16;
    @runtime("prim_rt_conv_sext16")
    fn from_i32_wrapping(x: i32) -> i16;
    @runtime("prim_rt_conv_sext16")
    fn from_u32_wrapping(x: u32) -> i16;
    @runtime("prim_rt_conv_sext16")
    fn from_isize_wrapping(x: isize) -> i16;
    @runtime("prim_rt_conv_sext16")
    fn from_usize_wrapping(x: usize) -> i16;
    @runtime("prim_rt_conv_wrap_sext16")
    fn from_i64_wrapping(x: i64) -> i16;
    @runtime("prim_rt_conv_wrap_sext16")
    fn from_u64_wrapping(x: u64) -> i16;
}

impl u32 {
    @runtime("prim_rt_conv_noop")
    fn from_i8_wrapping(x: i8) -> u32;
    @runtime("prim_rt_conv_noop")
    fn from_u8(x: u8) -> u32;
    @runtime("prim_rt_conv_noop")
    fn from_i16_wrapping(x: i16) -> u32;
    @runtime("prim_rt_conv_noop")
    fn from_u16(x: u16) -> u32;
    @runtime("prim_rt_conv_noop")
    fn from_i32_wrapping(x: i32) -> u32;
    @runtime("prim_rt_conv_noop")
    fn from_isize_wrapping(x: isize) -> u32;
    @runtime("prim_rt_conv_noop")
    fn from_usize(x: usize) -> u32;
    @runtime("prim_rt_conv_wrap_i64")
    fn from_i64_wrapping(x: i64) -> u32;
    @runtime("prim_rt_conv_wrap_i64")
    fn from_u64_wrapping(x: u64) -> u32;
}

impl i32 {
    @runtime("prim_rt_conv_noop")
    fn from_i8(x: i8) -> i32;
    @runtime("prim_rt_conv_noop")
    fn from_u8(x: u8) -> i32;
    @runtime("prim_rt_conv_noop")
    fn from_i16(x: i16) -> i32;
    @runtime("prim_rt_conv_noop")
    fn from_u16(x: u16) -> i32;
    @runtime("prim_rt_conv_noop")
    fn from_u32_wrapping(x: u32) -> i32;
    @runtime("prim_rt_conv_noop")
    fn from_isize(x: isize) -> i32;
    @runtime("prim_rt_conv_noop")
    fn from_usize_wrapping(x: usize) -> i32;
    @runtime("prim_rt_conv_wrap_i64")
    fn from_i64_wrapping(x: i64) -> i32;
    @runtime("prim_rt_conv_wrap_i64")
    fn from_u64_wrapping(x: u64) -> i32;
}

impl u64 {
    @runtime("prim_rt_f64_to_u64_trunc")
    fn from_f64_trunc(x: f64) -> u64;
    @runtime("prim_rt_conv_ext_i32_s")
    fn from_i8_wrapping(x: i8) -> u64;
    @runtime("prim_rt_conv_ext_i32_u")
    fn from_u8(x: u8) -> u64;
    @runtime("prim_rt_conv_ext_i32_s")
    fn from_i16_wrapping(x: i16) -> u64;
    @runtime("prim_rt_conv_ext_i32_u")
    fn from_u16(x: u16) -> u64;
    @runtime("prim_rt_conv_ext_i32_s")
    fn from_i32_wrapping(x: i32) -> u64;
    @runtime("prim_rt_conv_ext_i32_u")
    fn from_u32(x: u32) -> u64;
    @runtime("prim_rt_conv_ext_i32_s")
    fn from_isize_wrapping(x: isize) -> u64;
    @runtime("prim_rt_conv_ext_i32_u")
    fn from_usize(x: usize) -> u64;
    @runtime("prim_rt_conv_noop")
    fn from_i64_wrapping(x: i64) -> u64;
}

impl i64 {
    @runtime("prim_rt_conv_ext_i32_s")
    fn from_i8(x: i8) -> i64;
    @runtime("prim_rt_conv_ext_i32_u")
    fn from_u8(x: u8) -> i64;
    @runtime("prim_rt_conv_ext_i32_s")
    fn from_i16(x: i16) -> i64;
    @runtime("prim_rt_conv_ext_i32_u")
    fn from_u16(x: u16) -> i64;
    @runtime("prim_rt_conv_ext_i32_s")
    fn from_i32(x: i32) -> i64;
    @runtime("prim_rt_conv_ext_i32_u")
    fn from_u32(x: u32) -> i64;
    @runtime("prim_rt_conv_ext_i32_s")
    fn from_isize(x: isize) -> i64;
    @runtime("prim_rt_conv_ext_i32_u")
    fn from_usize(x: usize) -> i64;
    @runtime("prim_rt_conv_noop")
    fn from_u64_wrapping(x: u64) -> i64;
}

impl usize {
    @runtime("prim_rt_conv_noop")
    fn from_i8_wrapping(x: i8) -> usize;
    @runtime("prim_rt_conv_noop")
    fn from_u8(x: u8) -> usize;
    @runtime("prim_rt_conv_noop")
    fn from_i16_wrapping(x: i16) -> usize;
    @runtime("prim_rt_conv_noop")
    fn from_u16(x: u16) -> usize;
    @runtime("prim_rt_conv_noop")
    fn from_i32_wrapping(x: i32) -> usize;
    @runtime("prim_rt_conv_noop")
    fn from_u32(x: u32) -> usize;
    @runtime("prim_rt_conv_noop")
    fn from_isize_wrapping(x: isize) -> usize;
    @runtime("prim_rt_conv_wrap_i64")
    fn from_i64_wrapping(x: i64) -> usize;
    @runtime("prim_rt_conv_wrap_i64")
    fn from_u64_wrapping(x: u64) -> usize;
