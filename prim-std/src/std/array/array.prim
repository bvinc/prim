mod array

import std.ptr.add
import std.option.Option

// The builtin fixed-size array. Its representation (inline storage, N*size(T))
// is intrinsic; this stub gives it a nominal home for its type parameters and
// the inherent methods below.
@builtin type Array[T, const N: usize]

// Inherent methods on `Array[T, N]`. Const generics let these be written in
// plain Prim; the only compiler primitive is `ptr` (the array value
// reinterpreted as the address of its first element).

// A pointer to the array's first element. No-op reinterpret at the wasm level.
@runtime("prim_rt_array_ptr")
unsafe fn ptr[T, const N: usize](read a: Array[T, N]) -> *mut T;

impl Array[T, N] {
    // The number of elements (a compile-time constant).
    fn len(read self) -> usize {
        return N
    }
}

// A copy of element `i`, or `None` if `i` is out of bounds — no panic.
// The element must be `Copy` (a scalar/pointer, or an `impl Copy` struct):
// `*p` is a deref-read of the slot, and a non-`Copy` element is stored as a
// box pointer, so copying it out would alias the slot and double-free on drop.
// `T: Copy` makes that a plain type error at the call site. A free function
// (rather than an inherent method) because a method shares the whole impl's
// type parameters and cannot carry its own bound on `T`.
fn get[T: Copy, const N: usize](read a: Array[T, N], i: usize) -> Option[T] {
    if i < N {
        unsafe {
            return Option.Some(*add[T](ptr(a), i))
        }
    }
    return Option.None
}
