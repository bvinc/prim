mod time

import std.sys.now_nanos
import std.rt.park_until

// A span of time, stored as a whole number of nanoseconds — the same shape as
// Rust's `Duration`, just flattened to one field for now.
struct Duration {
    nanos: u64,
}

fn from_nanos(n: u64) -> Duration {
    return Duration { nanos = n }
}

fn from_micros(us: u64) -> Duration {
    return Duration { nanos = us * 1000u64 }
}

fn from_millis(ms: u64) -> Duration {
    return Duration { nanos = ms * 1000000u64 }
}

fn from_secs(s: u64) -> Duration {
    return Duration { nanos = s * 1000000000u64 }
}

fn as_nanos(d: view Duration) -> u64 {
    return d.nanos
}

fn as_millis(d: view Duration) -> u64 {
    return d.nanos / 1000000u64
}

fn as_secs(d: view Duration) -> u64 {
    return d.nanos / 1000000000u64
}

// A monotonic instant in nanoseconds. Subtract two to get elapsed time.
fn now() -> u64 {
    return now_nanos()
}

// Suspend the current green thread for at least `d`. Control returns to the
// scheduler, which wakes this task once the monotonic clock has advanced past
// `now + d`; other runnable tasks make progress in the meantime.
fn sleep(d: view Duration) {
    park_until(now_nanos() + d.nanos)
}
