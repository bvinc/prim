mod fs

import std.mem.alloc
import std.mem.free
import std.mem.at
import std.sys.write_raw
import std.sys.read_raw

// Direct WASI passthroughs. `path_open` resolves a path under a preopened
// directory fd and writes the new descriptor to `*opened`; `close_fd` releases
// a descriptor. Both return a WASI errno (0 on success).
@runtime("prim_rt_path_open")
fn path_open_raw(
    dir_fd: i32,
    dirflags: i32,
    path: *mut u8,
    path_len: usize,
    oflags: i32,
    rights_base: u64,
    rights_inheriting: u64,
    fdflags: i32,
    opened: *mut i32
) -> i32;

@runtime("prim_rt_close")
fn close_fd(fd: i32) -> i32;

// An open file. Owns its descriptor and closes it when dropped (RAII).
struct File {
    fd: i32,
}

// Open `path` under the first preopened directory (fd 3, the cwd granted by
// `prim run --dir .`) with the given WASI open flags. `rights` requests the
// read/write/seek/stat capabilities a regular file needs.
fn open_flags(path: String, oflags: i32) -> File {
    let out = alloc(4usize)
    let slot = at[i32](out, 0usize)
    // -1 if path_open fails (it leaves the slot untouched), so the resulting
    // File's read/write/close are harmless EBADFs rather than a stray fd.
    *slot = -1i32
    let rights = 2097222u64
    path_open_raw(3i32, 1i32, path.data, path.len, oflags, rights, rights, 0i32, slot)
    let fd = *slot
    free(out)
    return File { fd = fd }
}

impl File {
    // Create or truncate a file for writing (O_CREAT | O_TRUNC).
    fn create(path: String) -> File {
        return open_flags(path, 9i32)
    }

    // Open an existing file for reading.
    fn open(path: String) -> File {
        return open_flags(path, 0i32)
    }

    // Write `bytes`; returns the number of bytes written.
    fn write(view self, bytes: String) -> usize {
        return write_raw(self.fd, bytes.data, bytes.len)
    }

    // Read up to `cap` bytes into `buf`; returns the number read (0 at EOF).
    fn read(view self, buf: *mut u8, cap: usize) -> usize {
        return read_raw(self.fd, buf, cap)
    }
}

impl Drop for File {
    fn drop(edit self) {
        close_fd(self.fd)
    }
}
