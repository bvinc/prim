mod mem

// size_of[T]() — the in-memory size of T in bytes. Resolved to a constant
// during monomorphization once T is concrete, so it costs nothing at
// runtime. Backs generic pointer arithmetic and allocation sizing.
@runtime("prim_rt_size_of")
fn size_of[T]() -> usize;

// copy_bytes(dst, src, n) — copy n bytes (memmove semantics). The allocator
// and its public alloc/free/alloc_bytes/dealloc/alloc_array live alongside
// this module in dlmalloc.prim.
@runtime("prim_rt_memory_copy")
fn copy_bytes[T](dst: *mut T, src: *mut T, n: usize);
