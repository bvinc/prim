trusted mod io

import std.sys.write_raw
import std.sys.read_raw
import std.sys.path_open_raw
import std.sys.close_fd
import std.mem.alloc
import std.mem.free
import std.mem.at
import std.rt.park_on_read
import std.rt.park_on_write
import std.vec.Vec
import std.fmt.Display
import std.fmt.Formatter
import std.fmt.new_formatter
import std.fmt.Debug
import std.fmt.debug_string

// A sink for bytes. I/O is byte-oriented; text is just bytes (see the
// `Display` helpers below, which format into a byte buffer).
trait Writer {
    fn write(self, read bytes: Vec[u8]) -> usize;
}

// A source of bytes.
trait Reader {
    fn read_into(self, mut buf: Vec[u8]) -> usize;
}

// The standard streams are distinct, zero-sized handles whose descriptors
// outlive the program — so, unlike File, they implement no Drop and can never
// be closed. `stdin`/`stdout`/`stderr` return them.
struct Stdin {}
struct Stdout {}
struct Stderr {}

fn stdin() -> Stdin { return Stdin {} }
fn stdout() -> Stdout { return Stdout {} }
fn stderr() -> Stderr { return Stderr {} }

// An owned file: it owns its descriptor and closes it when dropped (RAII).
struct File {
    fd: i32,
}

// Open `path` under the first preopened directory (fd 3, the cwd granted by
// `prim run --dir .`) with the given WASI open flags. `rights` requests the
// read/write/seek/stat capabilities a regular file needs.
fn open_flags(read path: String, oflags: i32) -> File {
    let out = alloc(4usize)
    let slot = at[i32](out, 0usize)
    // -1 if path_open fails (it leaves the slot untouched), so a failed open's
    // read/write/close are harmless EBADFs rather than a stray fd.
    *slot = -1i32
    let rights = 2097222u64
    path_open_raw(3i32, 1i32, path.data, path.len, oflags, rights, rights, 0i32, slot)
    let fd = *slot
    free(out)
    return File { fd = fd }
}

impl File {
    // Create or truncate a file for writing (O_CREAT | O_TRUNC).
    fn create(read path: String) -> File {
        return open_flags(path, 9i32)
    }

    // Open an existing file for reading.
    fn open(read path: String) -> File {
        return open_flags(path, 0i32)
    }
}

impl Drop for File {
    fn drop(mut self) {
        close_fd(self.fd)
    }
}

// Shared fd-level I/O. Both park the task until the fd is ready, so a slow peer
// blocks only this task, not the whole scheduler. `read_fd` sets the buffer's
// length to the number of bytes read (0 at end of input).
fn write_fd(fd: i32, read bytes: Vec[u8]) -> usize {
    park_on_write(fd)
    return write_raw(fd, bytes.ptr, bytes.len)
}

fn read_fd(fd: i32, mut buf: Vec[u8]) -> usize {
    park_on_read(fd)
    let n = read_raw(fd, buf.ptr, buf.cap)
    buf.len = n
    return n
}

impl Writer for Stdout {
    fn write(self, read bytes: Vec[u8]) -> usize { return write_fd(1i32, bytes) }
}
impl Writer for Stderr {
    fn write(self, read bytes: Vec[u8]) -> usize { return write_fd(2i32, bytes) }
}
impl Writer for File {
    fn write(self, read bytes: Vec[u8]) -> usize { return write_fd(self.fd, bytes) }
}
impl Reader for Stdin {
    fn read_into(self, mut buf: Vec[u8]) -> usize { return read_fd(0i32, mut buf) }
}
impl Reader for File {
    fn read_into(self, mut buf: Vec[u8]) -> usize { return read_fd(self.fd, mut buf) }
}

// Render a `Display` value into a byte buffer and write it to any `Writer`,
// optionally followed by a newline. The `Formatter` accumulates a `Vec[u8]`, so
// the bytes go straight to the writer with no intermediate `String`.
fn write_display[W: Writer, T: Display](read w: W, read x: T, newline: bool) {
    let f = new_formatter()
    x.fmt(mut f)
    if newline {
        f.write_byte(10)
    }
    // Statement form (trailing `;`): the written-byte count is discarded
    // rather than becoming this unit function's value.
    w.write(f.buf);
}

// Render a `Display` value to stdout.
fn print[T: Display](read x: T) {
    write_display(stdout(), x, false)
}

// Render a `Display` value to stdout, followed by a newline.
fn println[T: Display](read x: T) {
    write_display(stdout(), x, true)
}

// Render a `Display` value to stderr.
fn eprint[T: Display](read x: T) {
    write_display(stderr(), x, false)
}

// Render a `Display` value to stderr, followed by a newline.
fn eprintln[T: Display](read x: T) {
    write_display(stderr(), x, true)
}

// Backs the `@dbg` expression: print the `[file:line] expr = ` prefix and the
// value's `Debug` form (with a trailing newline), then return the value so
// `@dbg e` still evaluates to `e`.
fn dbg[T: Debug](read prefix: String, own x: T) -> T {
    print(prefix)
    println(debug_string(x))
    return x
}
