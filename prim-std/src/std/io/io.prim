mod io

import std.mem.alloc
import std.mem.free
import std.ptr.byte_add
import std.convert.i64_to_u8_wrapping
import std.convert.u64_to_u8_wrapping
import std.convert.i8_to_i64
import std.convert.i16_to_i64
import std.convert.i32_to_i64
import std.convert.isize_to_i64
import std.convert.u8_to_u64
import std.convert.u16_to_u64
import std.convert.u32_to_u64
import std.convert.usize_to_u64
import std.convert.f64_to_u64_trunc
import std.convert.u64_to_f64
import std.convert.f32_to_f64

@runtime("prim_rt_write")
fn write(fd: i64, s: String);

fn print_str(s: String) {
    write(1, s);
    write(1, "\n");
}

@runtime("prim_rt_trap")
fn trap();

// Print a message and abort the program. Used for unrecoverable errors
// (failed invariants, out-of-bounds access) until Result-based handling.
fn panic(msg: String) {
    write(1, msg);
    write(1, "\n");
    trap()
}

// ---- integer printing ----
// Decimal digits are written backwards into a small heap buffer, then the
// slice is handed to write. The signed path uses a remainder-based loop so
// the most-negative value never overflows; the unsigned path uses unsigned
// division. Narrower types widen to i64/u64 and delegate. 24 bytes covers
// the widest output (20 digits + sign).

fn println_i64(x: i64) {
    let buf = alloc(24usize)
    let mut pos = 24usize
    let neg = x < 0i64
    let mut n = x
    loop {
        let rem = n % 10i64
        let digit = if rem < 0i64 { 0i64 - rem } else { rem }
        pos = pos - 1usize
        *byte_add[u8](buf, pos) = i64_to_u8_wrapping(48i64 + digit)
        n = n / 10i64
        if n == 0i64 { break }
    }
    if neg {
        pos = pos - 1usize
        *byte_add[u8](buf, pos) = 45u8
    }
    let s = String { data = byte_add[u8](buf, pos), len = 24usize - pos, cap = 24usize }
    print_str(s)
    free(buf)
}

fn println_u64(x: u64) {
    let buf = alloc(24usize)
    let mut pos = 24usize
    let mut n = x
    loop {
        let rem = n % 10u64
        pos = pos - 1usize
        *byte_add[u8](buf, pos) = u64_to_u8_wrapping(48u64 + rem)
        n = n / 10u64
        if n == 0u64 { break }
    }
    let s = String { data = byte_add[u8](buf, pos), len = 24usize - pos, cap = 24usize }
    print_str(s)
    free(buf)
}

fn println_i32(x: i32) {
    println_i64(i32_to_i64(x))
}

fn println_i16(x: i16) {
    println_i64(i16_to_i64(x))
}

fn println_i8(x: i8) {
    println_i64(i8_to_i64(x))
}

fn println_isize(x: isize) {
    println_i64(isize_to_i64(x))
}

fn println_u32(x: u32) {
    println_u64(u32_to_u64(x))
}

fn println_u16(x: u16) {
    println_u64(u16_to_u64(x))
}

fn println_u8(x: u8) {
    println_u64(u8_to_u64(x))
}

fn println_usize(x: usize) {
    println_u64(usize_to_u64(x))
}

// Print a float as decimal + newline. Fixed precision: the integer part in
// full, then up to 15 fractional digits with trailing zeros trimmed (at least
// one kept). This is not shortest-round-trip formatting. The integer part and
// each fractional digit are obtained by truncating across the float/int
// boundary; the digits themselves are ordinary integer formatting.
fn println_f64(x: f64) {
    let neg = x < 0.0f64
    let abs = if neg { 0.0f64 - x } else { x }
    let int_part = f64_to_u64_trunc(abs)
    let mut frac = abs - u64_to_f64(int_part)

    // 64-byte buffer: integer digits grow left from `dot`, fraction grows right.
    let buf = alloc(64usize)
    let dot = 32usize

    // Integer part, written backward ending just before the dot.
    let mut ip = int_part
    let mut start = dot
    loop {
        start = start - 1usize
        *byte_add[u8](buf, start) = u64_to_u8_wrapping(48u64 + ip % 10u64)
        ip = ip / 10u64
        if ip == 0u64 { break }
    }
    if neg {
        start = start - 1usize
        *byte_add[u8](buf, start) = 45u8
    }

    *byte_add[u8](buf, dot) = 46u8

    // Fractional digits, written forward after the dot (cap at 15).
    let mut end = dot + 1usize
    let mut count = 0usize
    loop {
        frac = frac * 10.0f64
        let digit = f64_to_u64_trunc(frac)
        *byte_add[u8](buf, end) = u64_to_u8_wrapping(48u64 + digit)
        frac = frac - u64_to_f64(digit)
        end = end + 1usize
        count = count + 1usize
        if frac < 0.0000000001f64 { break }
        if count >= 15usize { break }
    }
    // Trim trailing zeros, keeping at least one fractional digit.
    loop {
        if end <= dot + 2usize { break }
        if *byte_add[u8](buf, end - 1usize) != 48u8 { break }
        end = end - 1usize
    }

    let s = String { data = byte_add[u8](buf, start), len = end - start, cap = 64usize }
    print_str(s)
    free(buf)
}

fn println_f32(x: f32) {
    println_f64(f32_to_f64(x))
}

fn println_bool(b: bool) {
    if b {
        write(1, "true\n")
    } else {
        write(1, "false\n")
    }
}
