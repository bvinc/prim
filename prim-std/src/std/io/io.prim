mod io

import std.sys.write
import std.fmt.Display
import std.fmt.to_string

// Render any `Display` value to stdout, with no trailing newline.
fn print[T: Display](x: T) {
    write(1, to_string(x))
}

// Render any `Display` value to stdout, followed by a newline.
fn println[T: Display](x: T) {
    print(x)
    write(1, "\n")
}
