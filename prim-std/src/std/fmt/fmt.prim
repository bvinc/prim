trusted mod fmt

import std.vec.Vec
import std.vec.new
import std.vec.push
import std.string.from_vec
import std.ptr.byte_add

// A sink that accumulates formatted bytes. `Display` implementations write
// into it; `to_string` / `print` create one, run the impl, then own its
// bytes. `Formatter` is passed as a `mut`/`read` borrow so writes from nested
// `fmt` calls all land in the same buffer — no intermediate strings.
struct Formatter {
    buf: Vec[u8],
}

fn new_formatter() -> Formatter {
    return Formatter { buf = new[u8]() }
}

impl Formatter {
    fn write_byte(mut self, b: u8) {
        push[u8](mut self.buf, own b)
    }

    fn write_str(mut self, read s: String) {
        let mut i = 0usize
        while i < s.len {
            push[u8](mut self.buf, own *byte_add[u8](s.data, i))
            i = i + 1usize
        }
    }

    // Unsigned decimal. Digits are emitted most-significant first by recursing
    // before writing the low digit.
    fn write_u64(mut self, x: u64) {
        if x >= 10u64 {
            self.write_u64(x / 10u64)
        }
        push[u8](mut self.buf, own u8.from_u64_wrapping(48u64 + x % 10u64))
    }

    // Signed decimal. The magnitude is negated in u64 so the most-negative
    // value (whose positive doesn't fit in i64) still formats correctly.
    fn write_i64(mut self, x: i64) {
        if x < 0i64 {
            self.write_byte(45u8)
            self.write_u64(0u64 - u64.from_i64_wrapping(x))
        } else {
            self.write_u64(u64.from_i64_wrapping(x))
        }
    }

    // Decimal float: integer part in full, then up to 15 fractional digits
    // with trailing zeros trimmed (at least one kept). Not shortest-round-trip
    // formatting. Digits cross the float/int boundary by truncation. A first
    // pass counts the fractional digits worth keeping (the buffer only grows,
    // so trailing zeros can't be un-written); the second pass emits them.
    fn write_f64(mut self, x: f64) {
        let neg = x < 0.0f64
        let mut abs = x
        if neg {
            abs = 0.0f64 - x
        }
        if neg {
            self.write_byte(45u8)
        }
        let int_part = u64.from_f64_trunc(abs)
        self.write_u64(int_part)
        self.write_byte(46u8)
        let frac0 = abs - f64.from_u64(int_part)

        let mut frac = frac0
        let mut count = 0usize
        let mut keep = 1usize
        loop {
            frac = frac * 10.0f64
            let digit = u64.from_f64_trunc(frac)
            frac = frac - f64.from_u64(digit)
            count = count + 1usize
            if digit != 0u64 {
                keep = count
            }
            if frac < 0.0000000001f64 { break }
            if count >= 15usize { break }
        }

        frac = frac0
        let mut i = 0usize
        while i < keep {
            frac = frac * 10.0f64
            let digit = u64.from_f64_trunc(frac)
            push[u8](mut self.buf, own u8.from_u64_wrapping(48u64 + digit))
            frac = frac - f64.from_u64(digit)
            i = i + 1usize
        }
    }
}

// A type that can be rendered as text by writing into a `Formatter`.
trait Display {
    fn fmt(read self, mut f: Formatter);
}

impl Display for u8 {
    fn fmt(read self, mut f: Formatter) { f.write_u64(u64.from_u8(self)) }
}
impl Display for u16 {
    fn fmt(read self, mut f: Formatter) { f.write_u64(u64.from_u16(self)) }
}
impl Display for u32 {
    fn fmt(read self, mut f: Formatter) { f.write_u64(u64.from_u32(self)) }
}
impl Display for u64 {
    fn fmt(read self, mut f: Formatter) { f.write_u64(self) }
}
impl Display for usize {
    fn fmt(read self, mut f: Formatter) { f.write_u64(u64.from_usize(self)) }
}
impl Display for i8 {
    fn fmt(read self, mut f: Formatter) { f.write_i64(i64.from_i8(self)) }
}
impl Display for i16 {
    fn fmt(read self, mut f: Formatter) { f.write_i64(i64.from_i16(self)) }
}
impl Display for i32 {
    fn fmt(read self, mut f: Formatter) { f.write_i64(i64.from_i32(self)) }
}
impl Display for i64 {
    fn fmt(read self, mut f: Formatter) { f.write_i64(self) }
}
impl Display for isize {
    fn fmt(read self, mut f: Formatter) { f.write_i64(i64.from_isize(self)) }
}
impl Display for f32 {
    fn fmt(read self, mut f: Formatter) { f.write_f64(f64.from_f32(self)) }
}
impl Display for f64 {
    fn fmt(read self, mut f: Formatter) { f.write_f64(self) }
}
impl Display for bool {
    fn fmt(read self, mut f: Formatter) {
        if self {
            f.write_str("true")
        } else {
            f.write_str("false")
        }
    }
}
impl Display for String {
    fn fmt(read self, mut f: Formatter) { f.write_str(self) }
}

// Render a value to a fresh `String`.
fn to_string[T: Display](read x: T) -> String {
    let f = new_formatter()
    x.fmt(mut f)
    return from_vec(own f.buf)
}

// A type that can be rendered for *developers* — the representation that shows
// structure (quoted strings, `Point { x: 1 }`, `Some(3)`), as opposed to
// `Display`'s user-facing text. Backs `@dbg`, and will be auto-implemented for
// every struct and enum. For primitive numbers Debug matches Display; strings
// differ (Debug quotes them).
trait Debug {
    fn fmt(read self, mut f: Formatter);
}

impl Debug for u8 {
    fn fmt(read self, mut f: Formatter) { f.write_u64(u64.from_u8(self)) }
}
impl Debug for u16 {
    fn fmt(read self, mut f: Formatter) { f.write_u64(u64.from_u16(self)) }
}
impl Debug for u32 {
    fn fmt(read self, mut f: Formatter) { f.write_u64(u64.from_u32(self)) }
}
impl Debug for u64 {
    fn fmt(read self, mut f: Formatter) { f.write_u64(self) }
}
impl Debug for usize {
    fn fmt(read self, mut f: Formatter) { f.write_u64(u64.from_usize(self)) }
}
impl Debug for i8 {
    fn fmt(read self, mut f: Formatter) { f.write_i64(i64.from_i8(self)) }
}
impl Debug for i16 {
    fn fmt(read self, mut f: Formatter) { f.write_i64(i64.from_i16(self)) }
}
impl Debug for i32 {
    fn fmt(read self, mut f: Formatter) { f.write_i64(i64.from_i32(self)) }
}
impl Debug for i64 {
    fn fmt(read self, mut f: Formatter) { f.write_i64(self) }
}
impl Debug for isize {
    fn fmt(read self, mut f: Formatter) { f.write_i64(i64.from_isize(self)) }
}
impl Debug for f32 {
    fn fmt(read self, mut f: Formatter) { f.write_f64(f64.from_f32(self)) }
}
impl Debug for f64 {
    fn fmt(read self, mut f: Formatter) { f.write_f64(self) }
}
impl Debug for bool {
    fn fmt(read self, mut f: Formatter) {
        if self {
            f.write_str("true")
        } else {
            f.write_str("false")
        }
    }
}
// Debug quotes strings, so `"hi"` renders as `"hi"` rather than `hi`.
impl Debug for String {
    fn fmt(read self, mut f: Formatter) {
        f.write_byte(34u8)
        f.write_str(self)
        f.write_byte(34u8)
    }
}

// Render a value to a fresh `String` using its `Debug` representation.
fn debug_string[T: Debug](read x: T) -> String {
    let f = new_formatter()
    x.fmt(mut f)
    return from_vec(own f.buf)
}

// Write a value's `Debug` form into an existing formatter. The bound resolves
// `fmt` to `Debug` (not `Display`); derived `Debug` impls call this per field.
fn write_debug[T: Debug](mut f: Formatter, read x: T) {
    x.fmt(mut f)
}
