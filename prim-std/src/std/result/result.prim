mod result

import std.sys.panic_value

// The outcome of an operation that can fail: `Ok(t)` on success, `Err(e)`
// on failure.
enum Result[T, E] {
    Ok(T),
    Err(E),
}

// Methods are generic over the enum's `T` and `E`, inferred from the receiver:
// `r.unwrap()` on a `Result[i32, E]` monomorphizes with `T = i32`.
impl Result {
    // Whether this is an `Ok`.
    fn is_ok(view self) -> bool {
        return match self {
            Result.Ok(_) => true,
            Result.Err(_) => false,
        }
    }

    // Whether this is an `Err`.
    fn is_err(view self) -> bool {
        return match self {
            Result.Ok(_) => false,
            Result.Err(_) => true,
        }
    }

    // Extract the success value, aborting if the result is an `Err`. Consumes
    // the result.
    fn unwrap(take self) -> T {
        return match self {
            Result.Ok(take v) => v,
            Result.Err(_) => panic_value[T]("Result.unwrap called on Err"),
        }
    }

    // Extract the success value, or return `default` if it is an `Err`.
    fn unwrap_or(take self, take default: T) -> T {
        return match self {
            Result.Ok(take v) => v,
            Result.Err(_) => default,
        }
    }
}
