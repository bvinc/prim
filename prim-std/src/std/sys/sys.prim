mod sys

// Low-level runtime primitives with no Prim dependencies. Higher-level modules
// (vec's bounds checks, io's byte streams) build on these without creating
// import cycles back through io.

// Raw byte I/O over a file descriptor, mapping to WASI fd_write / fd_read.
// Both work on a pointer + length: bytes are bytes, with no String or Vec
// knowledge. Higher layers (std.io) wrap these in `Writer`/`Reader`.
@runtime("prim_rt_write")
fn write_raw(fd: i32, ptr: *mut u8, len: usize) -> usize;

@runtime("prim_rt_trap")
fn trap();

// Current monotonic time in nanoseconds (WASI clock_time_get). The base point
// is unspecified; only differences are meaningful. Backs std.time and the
// scheduler's wakers.
@runtime("prim_rt_now")
fn now_nanos() -> u64;

// Read up to `cap` bytes from `fd` into `ptr` (WASI fd_read). Returns the
// number of bytes read; 0 means end of input. Blocks the process if no data
// is ready — callers that share the scheduler should park on readability
// first (see std.io).
@runtime("prim_rt_read")
fn read_raw(fd: i32, ptr: *mut u8, cap: usize) -> usize;

// Open a path under a preopened directory fd (WASI path_open) and close a
// descriptor (WASI fd_close). These are the only WASI-specific file primitives;
// higher layers (std.io.File) build on them, so WASI stays confined here.
// `path_open_raw` writes the new descriptor to `*opened` and returns a WASI
// errno (0 on success); `close_fd` returns an errno.
@runtime("prim_rt_path_open")
fn path_open_raw(
    dir_fd: i32,
    dirflags: i32,
    path: *mut u8,
    path_len: usize,
    oflags: i32,
    rights_base: u64,
    rights_inheriting: u64,
    fdflags: i32,
    opened: *mut i32
) -> i32;

@runtime("prim_rt_close")
fn close_fd(fd: i32) -> i32;

// Wait (WASI poll_oneoff) on `nsubs` subscriptions laid out at `subs`, writing
// fired events to `events`; returns how many fired. The scheduler builds the
// subscription/event structs — one per parked task — so a single call blocks
// on every waker at once (timers and fd readiness/writability).
@runtime("prim_rt_poll")
fn poll(subs: *mut u8, events: *mut u8, nsubs: usize) -> usize;

// Print a message and abort the program. Used for unrecoverable errors
// (failed invariants, out-of-bounds access) until Result-based handling.
fn panic(msg: read String) {
    write_raw(1, msg.data, msg.len)
    let nl = "\n"
    write_raw(1, nl.data, nl.len)
    // Signal the abort to the host runner on stderr, then trap. A wasm trap
    // raised inside the scheduler's continuation is swallowed (the process would
    // exit 0), so `prim run` watches for this sentinel and reports a nonzero exit
    // code. Keep in sync with ABORT_SENTINEL in prim-cli/src/lib.rs.
    let abort = "prim-runtime-abort: nonzero exit\n"
    write_raw(2, abort.data, abort.len)
    trap()
}

// Like `panic`, but usable where a value of any type `T` is expected (e.g. a
// `match` arm), since it never returns. The trailing `trap()` is unreachable
// (`panic` already aborts) but proves divergence to the return checker.
fn panic_value[T](msg: read String) -> T {
    panic(msg)
    trap()
}
