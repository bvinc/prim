mod sys

// Low-level runtime primitives with no Prim dependencies. Higher-level modules
// (vec's bounds checks, io's formatted output) build on these without creating
// import cycles back through io.

@runtime("prim_rt_write")
fn write(fd: i64, s: String);

@runtime("prim_rt_trap")
fn trap();

// Print a message and abort the program. Used for unrecoverable errors
// (failed invariants, out-of-bounds access) until Result-based handling.
fn panic(msg: String) {
    write(1, msg);
    write(1, "\n");
    trap()
}
