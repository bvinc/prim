trusted mod string

import std.vec.Vec
import std.ptr.null
import std.mem.free

@repr("C")
struct String {
    data: *mut u8,
    len: usize,
    cap: usize,
}

// String owns its buffer: `impl Drop` frees it (RAII). This is exactly why
// String deliberately has no `impl Copy` — duplicating a String would alias
// the buffer and double-free. The buffer is null for a default/empty String,
// and `free` ignores null.
impl Drop for String {
    fn drop(mut self) {
        free(self.data)
    }
}

// Build a String from a byte vector. The buffer is handed over as-is (no copy):
// the String takes ownership of it, and the source Vec's pointer is nulled so
// its `Drop` won't free the buffer the String now owns.
fn from_vec(own bytes: Vec[u8]) -> String {
    let p = bytes.ptr
    bytes.ptr = null[u8]()
    return String { data = p, len = bytes.len, cap = bytes.cap }
}
