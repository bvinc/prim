mod option

import std.sys.panic_value

// An optional value: `Some(x)` holds a `T`, `None` holds nothing.
enum Option[T] {
    None,
    Some(T),
}

// Methods are generic over the enum's `T`, inferred from the receiver: a call
// `o.unwrap()` on an `Option[i32]` monomorphizes the method with `T = i32`.
impl Option {
    // Whether this is a `Some`. Borrows the value (`read self`).
    fn is_some(read self) -> bool {
        return match self {
            Option.Some(_) => true,
            Option.None => false,
        }
    }

    // Whether this is a `None`.
    fn is_none(read self) -> bool {
        return match self {
            Option.Some(_) => false,
            Option.None => true,
        }
    }

    // Extract the value, aborting if there is none. Consumes the option.
    fn unwrap(take self) -> T {
        return match self {
            Option.Some(take v) => v,
            Option.None => panic_value[T]("Option.unwrap called on None"),
        }
    }

    // Extract the value, or return `default` if there is none.
    fn unwrap_or(take self, default: T) -> T {
        return match self {
            Option.Some(take v) => v,
            Option.None => default,
        }
    }
}
